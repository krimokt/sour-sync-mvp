NEXT_PUBLIC_APP_URL=https://soursync.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
NEXT_PUBLIC_DASHBOARD_CNAME_TARGET=customers.soursync.com
JWT_SECRET=
NEXT_PUBLIC_GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
