# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Platform URLs ----
# Apex/platform domain. Used for redirects and the "default" store URL.
NEXT_PUBLIC_SITE_URL=https://soursync.com
NEXT_PUBLIC_APP_URL=https://soursync.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://soursync.com

# ---- Vercel custom-domain automation ----
# Token: Vercel dashboard > Account Settings > Tokens (scope it to the team).
VERCEL_API_TOKEN=
# Project id (Vercel project > Settings > General > Project ID), or the project name.
VERCEL_PROJECT_ID=
# Team/scope id (Vercel team > Settings > General > Team ID). Omit for a personal account.
VERCEL_TEAM_ID=

# ---- Auth / misc ----
JWT_SECRET=
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_UPGRADE_CONTACT_EMAIL=
NEXT_PUBLIC_UPGRADE_CONTACT_URL=

# ---- Rate limiting (optional; no-op if unset) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTE: NETLIFY_SITE_ID / NETLIFY_ACCESS_TOKEN are no longer used.
