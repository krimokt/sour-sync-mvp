# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Platform URLs ----
# Apex/platform domain. Used for redirects and the "default" store URL.
NEXT_PUBLIC_SITE_URL=https://soursync.com
NEXT_PUBLIC_APP_URL=https://soursync.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://soursync.com

# ---- Cloudflare for SaaS (tenant custom-domain automation) ----
# Token scoped to the zone with "SSL and Certificates: Edit" + "Custom Hostnames" perms.
CLOUDFLARE_API_TOKEN=
# Zone id for soursync.com (Cloudflare dashboard > domain > Overview > API).
CLOUDFLARE_ZONE_ID=
# Origin the fallback origin / DNS records point at (where the app actually runs).
CLOUDFLARE_CUSTOM_ORIGIN_SERVER=origin.soursync.com
# The proxied hostname tenants CNAME their custom domain to (public, client-side).
NEXT_PUBLIC_DASHBOARD_CNAME_TARGET=customers.soursync.com

# ---- Auth / misc ----
JWT_SECRET=
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_UPGRADE_CONTACT_EMAIL=
NEXT_PUBLIC_UPGRADE_CONTACT_URL=

# ---- Rate limiting (optional; no-op if unset) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTE: NETLIFY_SITE_ID / NETLIFY_ACCESS_TOKEN are no longer used.
